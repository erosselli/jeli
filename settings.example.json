{
  "hooks": {
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PreToolUse":         [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PostToolUse":        [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PermissionRequest":  [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PermissionDenied":   [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "Notification":       [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "StopFailure":        [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "SubagentStart":      [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "SubagentStop":       [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "TaskCreated":        [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "TaskCompleted":      [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PreCompact":         [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "PostCompact":        [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }],
    "CwdChanged":         [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 ~/jeli/agent_hook.py", "timeout": 5, "async": true }] }]
  }
}
